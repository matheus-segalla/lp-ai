# ===================================================
# CONFIGURAÇÃO STRIPE (.env.local)
# ===================================================

# Sua chave secreta do Stripe (Obtenha no Stripe Dashboard > Desenvolvedores > Chaves de API)
# Teste: começa com sk_test_... | Produção: começa com sk_live_...
STRIPE_SECRET_KEY=sk_test_substitua_pela_sua_chave_secreta

# Chave pública (opcional para front-end)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Segredo do Webhook (Obtenha no Stripe CLI com `stripe listen` ou no Dashboard > Webhooks)
# Começa com whsec_...
STRIPE_WEBHOOK_SECRET=whsec_substitua_pelo_seu_webhook_secret

# Dados do Produto e Preço fornecidos:
STRIPE_PRODUCT_ID=prod_VNxJqXKSD1q1D9
STRIPE_PRICE_ID=price_1UNBPHJ8GWZznJJJCaeFtQAs

# URL base da sua aplicação (localhost para desenvolvimento, sua URL de produção ao publicar)
DOMAIN=http://localhost:3000

# Porta do servidor Node.js
PORT=3000
